{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.cjs server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run src/__tests__/foundation.test.ts",
    "test:e2e": "vitest run src/__tests__/foundation.test.ts",
    "scan:secrets": "tsx -e \"import { runSecretScan } from './scripts/secret-scanner.ts'; console.log(runSecretScan());\"",
    "migrations:safety": "tsx -e \"import { executeFullMigrationSafetySuite } from './packages/db/src/migration-safety.ts'; console.log(executeFullMigrationSafetySuite());\"",
    "dr:rehearse": "tsx -e \"import { disasterRecoveryEngine } from './packages/workflow/src/dr-recovery.ts'; console.log(disasterRecoveryEngine.runFullDRRehearsal());\"",
    "release:check": "tsx scripts/release-check.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run release:check && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "pg-mem": "^3.0.14",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
